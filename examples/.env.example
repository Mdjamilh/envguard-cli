# Example schema for a typical web app. Every variable is required unless it
# is marked @optional or has a @default.

# Where the app connects to Postgres.
# @type url @secret
DATABASE_URL=postgres://localhost:5432/app

# Port the HTTP server listens on.
# @type port @default 3000
PORT=3000

# @enum development, production, test
NODE_ENV=development

# How many background workers to run.
# @type int @min 1 @max 64 @default 4
WORKERS=4

# Signs session cookies. Generate one with: openssl rand -hex 32
# @secret @min 32
SESSION_SECRET=

# @type email @optional
SUPPORT_EMAIL=support@example.com

# @type duration @default 30s
REQUEST_TIMEOUT=30s

# @type bool @default false
ENABLE_SIGNUPS=false

# Stripe secret key; test keys in development.
# @optional @secret
# @pattern sk_(test|live)_[A-Za-z0-9]+
STRIPE_SECRET_KEY=

# @deprecated use DATABASE_URL instead
DB_HOST=
